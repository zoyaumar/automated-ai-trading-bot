# ---- Alpaca (trading-only keys) ----
# `mode` in config.yaml picks which pair is used.
# Leave the live pair blank until go-live.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=

# ---- LLM (any OpenAI-compatible provider) ----
# base_url, model, and provider live in config.yaml, not here.
NVIDIA_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ---- Data ----
FINNHUB_API_KEY=
FRED_API_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # the client's numeric chat ID, the only one allowed

# ---- Monitoring ----
HEARTBEAT_URL=             # dead-man's-switch ping URL